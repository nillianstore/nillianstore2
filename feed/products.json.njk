---
permalink: /products.json
eleventyExcludeFromCollections: true
---
{
  "products": [
    {%- for item in collections.shops %}
      {
        "title": "{{ item.data.title }}",
        "description": "{{ item.data.description | striptags | xmlEncode }}",
        "image": "{{ site.url }}{{ item.data.cover }}",
        "price": "{{ item.data.price }}",
        "link": "{{ site.url }}{{ item.url | url }}"
      }{%- if not loop.last or collections.digitals.length > 0 %},{% endif %}
    {%- endfor -%}
    {%- for item in collections.digitals %}
      {
        "title": "{{ item.data.title }}",
        "description": "{{ item.data.description | striptags | xmlEncode }}",
        "image": "{{ site.url }}{{ item.data.cover }}",
        "price": "AED {{ item.data.priceAed }} / ${{ item.data.priceUsd }} USD (digital)",
        "link": "{{ site.url }}{{ item.url | url }}"
      }{%- if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}