<div class="row justify-content-center">
{% for shop in shopslist | reverse %}
  <div class="col-md-4 p-3 p-md-5">
  <a href="{{ shop.url | url }}" class="text-dark">
  {% if shop.data.cover %}<img class="img-fluid rounded" alt="{{ shop.data.cover_alt or shop.data.title }}" width="600" height="600" loading="lazy" style="width: 100%; height: auto;" src="{{shop.data.cover}}"/>{% endif %}
    <div class="p-3">
    <h4><strong>{% if shop.data.title %}{{ shop.data.title }}{% else %}<code>{{ shop.url }}</code>{% endif %}</strong></h4>
    {% if shop.data.description %}<p>{{shop.data.description}}</p>{% endif %}
    </div>
  </a>
  </div>
{% endfor %}
  </div>