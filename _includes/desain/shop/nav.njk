{%- set nextshop = collections.shops | getNextCollectionItem(page) %}
{%- set previousshop = collections.shops | getPreviousCollectionItem(page) %}
{%- if nextshop or previousshop %}
<nav class="pnav my-4" aria-label="Product navigation">
  {%- if previousshop %}<a href="{{ previousshop.url | url }}" class="pnav-link prev"><span>← Previous</span><strong>{{ previousshop.data.title | truncate(40) }}</strong></a>{% endif %}
  {%- if nextshop %}<a href="{{ nextshop.url | url }}" class="pnav-link next"><span>Next →</span><strong>{{ nextshop.data.title | truncate(40) }}</strong></a>{% endif %}
</nav>
{%- endif %}
