<article class="container py-4">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="small text-muted mb-3">
    <ol class="breadcrumb mb-0">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item"><a href="/shop/">Shop</a></li>
      <li class="breadcrumb-item active" aria-current="page">{{ title | truncate(48) }}</li>
    </ol>
  </nav>

  <!-- 1. Product Title -->
  <h1 class="mb-2">{{ title }}</h1>
  <p class="lead text-muted mb-4">{{ description }}</p>

  <!-- 2. Cover (Left) + Features, Price & CTA (Right) -->
  <div class="row align-items-start g-4 mb-5">
    <div class="col-md-6">
      {% if cover %}
        <div class="cover-frame">
          <img
            src="{{ cover }}"
            alt="{{ cover_alt or title }}"
            width="600"
            height="600"
            fetchpriority="high"
          />
        </div>
      {% else %}
        <p class="text-muted">No image available</p>
      {% endif %}
    </div>

    <div class="col-md-6">
      <ul class="list-unstyled small mb-3">
        <li class="fw-semibold mb-1">Key features</li>
        {% for point in bullet_points %}
          <li class="mb-1">✓ {{ point }}</li>
        {% endfor %}
      </ul>

      <p class="h3 mb-3">{{ price }}</p>

      <a
        href="{{ amazonLink }}"
        target="_blank"
        rel="noopener nofollow sponsored"
        id="amazon-buy-button"
        class="btn btn-lg px-4 w-100">
        Buy on Amazon.ae
      </a>
      <p class="text-muted mt-2 small text-center">
        Ships from Amazon.ae • Fast UAE delivery • Easy returns
      </p>

      <div class="trust-badges mt-3">
        <span><i class="fas fa-shield-alt me-1"></i>Secure Amazon Checkout</span>
        <span><i class="fas fa-truck me-1"></i>Fast UAE Delivery</span>
        <span><i class="fas fa-undo me-1"></i>Easy Returns</span>
      </div>

      <div class="text-center mt-3">
        <a href="/shipping-policy/" class="small me-3">Shipping</a>
        <a href="/refund-policy/" class="small me-3">Returns</a>
        <a href="/privacy-policy/" class="small me-3">Privacy</a>
        <a href="/terms-of-service/" class="small">Terms</a>
      </div>
    </div>
  </div>

  <!-- 3. Tags -->
  <div class="mb-4 d-flex flex-wrap gap-2">
    {% for tag in tags | filterTagList %}
      {% if tag in collections.tagList %}
      <a href="/tags/{{ tag | safeSlug }}/" class="tag-pill">#{{ tag }}</a>
      {% endif %}
    {% endfor %}
  </div>

  <!-- 4. Gallery (if multiple images) -->
  {% if images and images.length > 1 %}
    <div class="my-5">
      <h2 class="h4 mb-3">More Views</h2>
      {% include "desain/shop/gallery.njk" %}
    </div>
  {% endif %}

  <!-- 5. Product Details -->
  <div class="prose col-lg-10 mx-auto my-4">
    <h2 class="h4">Product Details</h2>
    {{ content | safe }}
  </div>

  <!-- 6. Related Products -->
  {% set relatedShops = collections.shop %}
  {% set currentTags = tags | filterTagList %}
  {% set related = [] %}
  {% for item in relatedShops %}
    {% if item.url != page.url %}
      {% set itemTags = item.data.tags | filterTagList %}
      {% for t in currentTags %}
        {% if t in itemTags %}
          {% if related.push(item) %}{% endif %}
        {% endif %}
      {% endfor %}
    {% endif %}
  {% endfor %}
  {% if related.length > 0 %}
  <section class="my-5">
    <h2 class="h3 mb-4">You might also like</h2>
    <div class="row g-4">
      {% for rel in related | head(4) %}
        <div class="col-6 col-md-3">
          <a href="{{ rel.url | url }}" class="card product-card text-decoration-none text-dark">
            <div class="card-img-wrap">
              {% if rel.data.cover %}<img src="{{ rel.data.cover }}" alt="{{ rel.data.cover_alt or rel.data.title }}" loading="lazy" width="600" height="600"/>{% endif %}
            </div>
            <div class="card-body">
              <p class="title fw-semibold mb-1">{{ rel.data.title }}</p>
              <p class="price mb-0">{{ rel.data.price }}</p>
            </div>
          </a>
        </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <!-- 7. Previous / Next -->
  {% include "desain/shop/nav.njk" %}
</article>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var buyButton = document.getElementById('amazon-buy-button');
  if (buyButton) {
    buyButton.addEventListener('click', function() {
      if (typeof gtag === 'function') {
        gtag('event', 'begin_checkout', {
          'currency': 'AED',
          'value': {{ price | replace("AED ", "") | replace(",", "") | default(0) }},
          'items': [
            {
              'item_id': '{{ ecwidId }}',
              'item_name': '{{ title }}',
              'price': {{ price | replace("AED ", "") | replace(",", "") | default(0) }},
              'quantity': 1
            }
          ]
        });
        gtag('event', 'ads_conversion_Begin_checkout_1', {
          'currency': 'AED',
          'value': {{ price | replace("AED ", "") | replace(",", "") | default(0) }}
        });
      }
    });
  }
});
</script>
