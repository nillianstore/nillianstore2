<div class="product-gallery my-4">
  {% if images and images.length > 1 %}
    <!-- Swiper Carousel for Multiple Images -->
    <div class="swiper">
      <div class="swiper-wrapper">
        {% for img in images %}
          <div class="swiper-slide d-flex justify-content-center">
            <img
              src="{{ img }}"
              alt="{{ image_alts[loop.index0] or (title ~ ' - Image ' ~ loop.index) }}"
              class="img-fluid rounded"
              width="1200"
              height="1200"
              style="max-height: 500px; object-fit: contain;"
              {% if loop.index0 > 0 %}loading="lazy" decoding="async"{% else %}fetchpriority="high"{% endif %}
            />
          </div>
        {% endfor %}
      </div>
      <!-- Navigation Arrows -->
      <div class="swiper-button-next"></div>
      <div class="swiper-button-prev"></div>
      <!-- Pagination Dots -->
      <div class="swiper-pagination"></div>
    </div>
  {% elif images and images.length == 1 %}
    <!-- Single Image -->
    <div class="text-center">
      <img
        src="{{ images[0] }}"
        alt="{{ title }}"
        class="img-fluid rounded"
        width="1200"
        height="1200"
        style="max-height: 500px; object-fit: contain;"
        fetchpriority="high"
      />
    </div>
  {% elif cover %}
    <!-- Fallback to old 'cover' field -->
    <div class="text-center">
      <img
        src="{{ cover }}"
        alt="{{ title }}"
        class="img-fluid rounded"
        width="1200"
        height="1200"
        style="max-height: 500px; object-fit: contain;"
        fetchpriority="high"
      />
    </div>
  {% else %}
    <p class="text-muted">No image available</p>
  {% endif %}
</div>
