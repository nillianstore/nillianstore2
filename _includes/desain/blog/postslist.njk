{% if postslist and postslist.length %}
<div class="row g-4">
  {% for post in postslist | reverse %}
  <div class="col-md-6">
    <a href="{{ post.url | url }}" class="card product-card text-decoration-none text-dark">
      {% if post.data.cover %}<div class="card-img-wrap ratio-16x9"><img src="{{ post.data.cover }}" alt="{{ post.data.cover_alt or post.data.title }}" loading="lazy" width="600" height="400"/></div>{% endif %}
      <div class="card-body">
        <p class="title fw-semibold mb-1">{{ post.data.title }}</p>
        {% if post.data.description %}<p class="excerpt mb-0">{{ post.data.description | striptags | truncate(120) }}</p>{% endif %}
      </div>
    </a>
  </div>
  {% endfor %}
</div>
{% endif %}
