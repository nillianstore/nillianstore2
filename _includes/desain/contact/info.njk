<div class="container py-5">
  <div class="row g-4">
    <!-- Email -->
    <div class="col-md-4">
      <div class="contact-card h-100">
        <div class="contact-icon">&#9993;</div>
        <h5 class="mt-3 mb-2">Email Us</h5>
        <p class="text-muted small mb-3">We reply within 24 hours.</p>
        <a href="mailto:{{ email }}" class="text-dark fw-semibold text-decoration-none">{{ email }}</a>
      </div>
    </div>

    <!-- Amazon Storefront -->
    <div class="col-md-4">
      <div class="contact-card h-100">
        <div class="contact-icon amazon">&#9993;</div>
        <h5 class="mt-3 mb-2">Amazon.ae Storefront</h5>
        <p class="text-muted small mb-3">Shop our full curated collection directly on Amazon.ae.</p>
        <a href="{{ amazonStore }}" target="_blank" rel="noopener nofollow sponsored" class="btn btn-dark btn-sm">Visit Storefront</a>
      </div>
    </div>

    <!-- Location -->
    <div class="col-md-4">
      <div class="contact-card h-100">
        <div class="contact-icon">&#9678;</div>
        <h5 class="mt-3 mb-2">Based in</h5>
        <p class="text-muted small mb-1">{{ address }}, United Arab Emirates</p>
        <p class="text-muted small mb-0">Online &mdash; available 24/7</p>
      </div>
    </div>
  </div>

  <!-- Follow -->
  <div class="text-center mt-4">
    <h5 class="fw-bold">Follow us</h5>
    <div class="d-flex justify-content-center mt-3 gap-4">
      <a href="https://www.instagram.com/nillianstore" target="_blank" rel="noopener nofollow" class="btn btn-outline-dark btn-sm">Instagram</a>
      <a href="https://www.facebook.com/share/17DyggcD7b/?mibextid=wwXIfr" target="_blank" rel="noopener nofollow" class="btn btn-outline-dark btn-sm">Facebook</a>
      <a href="https://www.tiktok.com/@nillianstore" target="_blank" rel="noopener nofollow" class="btn btn-outline-dark btn-sm">TikTok</a>
    </div>
  </div>

  <p class="text-center text-muted small mt-4 mb-0">All purchases are securely processed through Amazon.ae with buyer protection.</p>
</div>
