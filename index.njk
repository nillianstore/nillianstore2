---
layout: layouts/home.njk
---
{% set heroProducts = collections.shops | reverse | head(4) %}
{% set featured = collections.shops | reverse | head(8) %}
{% set newShops = collections.shops | head(-5) %}
{% set newShopsCounter = collections.shops | length %}
{% set shopslist = collections.shops | head(-5) %}
{% set postslist = collections.posts | head(-3) %}
{% set postslistCounter = collections.posts | length %}

<!-- ============ HERO (Option B split hero) ============ -->
<section class="ns-hero">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <h1 class="ns-h1">{{home.title1}}</h1>
        <p class="ns-sub">{{home.intro1}} <span class="text-muted">{{home.title2}}</span></p>
        <div class="d-flex flex-wrap gap-2 mt-3">
          <a href="/shop/" class="btn btn-dark btn-lg me-2">Shop Products</a>
          <a href="{{ metadata.social.amazon }}" target="_blank" rel="noopener nofollow sponsored" class="btn btn-outline-dark btn-lg">Amazon.ae Storefront</a>
        </div>
        <ul class="ns-trustlist">
          <li>Fast UAE delivery</li>
          <li>Secure Amazon checkout</li>
          <li>Easy returns</li>
        </ul>
      </div>
      <div class="col-lg-6">
        <div class="hero-collage">
          {% for p in heroProducts %}
          <a href="{{ p.url | url }}" class="hc-tile" style="--i: {{ loop.index }}">
            {% if p.data.cover %}<img src="{{ p.data.cover }}" alt="{{ p.data.cover_alt or p.data.title }}" loading="lazy" width="400" height="400"/>{% endif %}
          </a>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ FEATURED SCROLLER (from Option A) ============ -->
<section class="featured" aria-label="Featured products">
  <div class="container-fluid">
    <div class="d-flex justify-content-between align-items-end mb-3 px-4">
      <h2 class="h3 mb-0">Featured Products</h2>
      <a href="/shop/" class="btn btn-dark btn-sm">View All</a>
    </div>
    <div class="scroller">
      {% for p in featured %}
      <a href="{{ p.url | url }}" class="card product-card text-decoration-none text-dark">
        <div class="card-img-wrap">
          {% if p.data.cover %}<img src="{{ p.data.cover }}" alt="{{ p.data.cover_alt or p.data.title }}" loading="lazy" width="600" height="600"/>{% endif %}
        </div>
        <div class="card-body">
          <p class="title fw-semibold mb-1">{{ p.data.title }}</p>
          <p class="price mb-0">{{ p.data.price }}</p>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ============ NEW PRODUCTS GRID (Option B) ============ -->
<section class="products" aria-label="New products">
  <div class="container">
    <div class="row align-items-end mb-4">
      <div class="col-sm">
        <h2 class="h3 mb-0">New Products</h2>
        <p class="text-muted mb-0">{{ newShopsCounter }} handpicked finds, updated weekly</p>
      </div>
      <div class="col-sm text-end">
        <a href="/shop/" class="btn btn-dark btn-sm">Explore All Products</a>
      </div>
    </div>
    <div class="row g-4">
      {% for shop in newShops %}
      <div class="col-6 col-md-4 col-lg-3">
        <a href="{{ shop.url | url }}" class="card product-card text-decoration-none text-dark">
          <div class="card-img-wrap">
            {% if shop.data.cover %}<img src="{{ shop.data.cover }}" alt="{{ shop.data.cover_alt or shop.data.title }}" loading="lazy" width="600" height="600"/>{% endif %}
          </div>
          <div class="card-body">
            <p class="title fw-semibold mb-1">{{ shop.data.title }}</p>
            <p class="price mb-0">{{ shop.data.price }}</p>
          </div>
        </a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ============ LATEST FROM THE BLOG ============ -->
<section class="products">
  <div class="container">
    <div class="row align-items-end mb-4">
      <div class="col-sm">
        <h2 class="h3 mb-0">From the Blog</h2>
        <p class="text-muted mb-0">Ideas and guides for UAE homes</p>
      </div>
      <div class="col-sm text-end">
        <a href="/posts/" class="btn btn-dark btn-sm">Read All Posts</a>
      </div>
    </div>
    <div class="row g-4">
      {% for post in postslist %}
      <div class="col-md-4">
        <a href="{{ post.url | url }}" class="card product-card text-decoration-none text-dark">
          {% if post.data.cover %}<div class="card-img-wrap ratio-16x9"><img src="{{ post.data.cover }}" alt="{{ post.data.cover_alt or post.data.title }}" loading="lazy" width="600" height="400"/></div>{% endif %}
          <div class="card-body">
            <p class="title fw-semibold mb-1">{{ post.data.title }}</p>
            <p class="excerpt mb-0">{{ post.data.description }}</p>
          </div>
        </a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ============ AMAZON BANNER (was: video CTA) ============ -->
<section class="banner">
  <div class="container py-5 text-center">
    <h2 class="h3 mb-2">Shop with confidence on Amazon.ae</h2>
    <p class="text-muted mx-auto" style="max-width: 560px;">{{home.intro2}}</p>
    <a href="{{ metadata.social.amazon }}" target="_blank" rel="noopener nofollow sponsored" class="btn btn-dark btn-lg mt-2">Visit Our Amazon.ae Storefront</a>
  </div>
</section>
